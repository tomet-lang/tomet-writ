# Normalize all text files to LF line endings
* text=auto eol=lf

#= Linguist
tmtroot/ linguist-documentation=true
*.md linguist-language=Markdown
*.tmt linguist-language=Tomet

# `.md` under tmtroot/spec/ and tmtroot/guide/ is exported from the sibling
# `.tmt` source via `@config(export:)`, so it is generated, not authored.
# Scoped by path on purpose: the `.md` under tmtroot/develop/ and
# tmtroot/design/ is hand-written and must stay a normal, reviewable file.
tmtroot/spec/**/*.md linguist-generated=true
tmtroot/guide/**/*.md linguist-generated=true

# Frozen parser/formatter test inputs, deliberately not synced with tmtroot/.
tests/fixtures/ linguist-vendored=true

#= Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
